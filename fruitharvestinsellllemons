local localQueue   = {}
local queueIndex   = 1
local queueLock    = false
local totalBought  = 0
local totalFailed  = 0
local lastResetTime = 0

-- === TUNING DEL CHORRO CONTINUO ===
-- El worker compra rapido; si el coord se duerme 0.5s, la cola se vacia.
-- Estos parametros mantienen el buffer SIEMPRE lleno para que nunca espere.
local QUEUE_TARGET_BUFFER = 40   -- buffer objetivo (items disponibles tras refill)
local QUEUE_REFILL_AT     = 25   -- si la cola baja de esto, el Coord rellena YA
local QUEUE_WORKER_TOPUP  = 15   -- el worker tambien se auto-rellena bajo este nivel
local QUEUE_COORD_TICK    = 0.05 -- el coord vigila cada 50ms (antes 500ms)

local function appendNewButtons()
    while queueLock do task_wait(0.001) end
    queueLock = true

    if not myTycoon or not myTycoon.Parent then
        queueLock = false
        return 0
    end

    local buttons = getButtonsRealTime()
    lastButtonCount = #buttons

    local existingKeys = {}
    local lq = localQueue
    local lqLen = #lq
    for i = queueIndex, lqLen do
        local it = lq[i]
        if it and it.key then existingKeys[it.key] = true end
    end

    local chr = player.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    local hrpPos = hrp and hrp.Position or nil
    local added = 0

    for _, v in ipairs_(buttons) do
        local key = getButtonKey(v)
        if key then
            local fails = failedButtons[key] or 0
            if not existingKeys[key] and fails < 2 and not isGreyedOut(v) and not buyBlacklist[key] then
                local dist = hrpPos and (v.Position - hrpPos).Magnitude or 999999
                tinsert(lq, {
                    btn   = v,
                    key   = key,
                    dist  = dist,
                    fails = fails
                })
                added = added + 1
            end
        end
    end

    queueLock = false
    return added
end

local function allButtonsDead()
    local buttons = getButtonsRealTime()
    if #buttons == 0 then return false end
    for _, v in ipairs_(buttons) do
        local key = getButtonKey(v)
        if key then
            local fails = failedButtons[key] or 0
            if fails < 2 and not buyBlacklist[key] and not isGreyedOut(v) then
                return false
            end
        end
    end
    return true
end

local function cleanupQueue()
    while queueLock do task_wait(0.001) end
    queueLock = true

    if queueIndex > 20 then
        local newQueue = {}
        local lq = localQueue
        local n = 0
        for i = queueIndex, #lq do
            n = n + 1
            newQueue[n] = lq[i]
        end
        localQueue = newQueue
        queueIndex = 1
    end

    queueLock = false
end


-- ==================== AUTO STAND (TP a Purchases/* y spam E) ====================
-- Cuando todos los botones de TP estan "muertos" (sin botones disponibles o todos
-- fallaron/blackliisted), entramos a esta rutina: TPea al HRP a cada Model dentro
-- de myTycoon.Purchases en orden (oldest first = orden de hijos), mantiene apretado
-- E 10 veces para mejorar stands, y entre cada stand re-escanea botones. Si aparece
-- alguno nuevo, sale del modo stand y vuelve a la cola de botones.

local STAND_KEY            = 0x45             -- Windows VK_E. NO usar Enum.KeyCode.E: en Matcha resuelve a 5 (XBUTTON1).
local STAND_PRESSES        = 1                -- E por stand (1 = tap instantaneo, como un click)
local STAND_TP_SETTLE      = 0.05             -- espera tras TP antes de tapear E
local STAND_CYCLE_PAUSE    = 0.02             -- pausa entre stands
local STAND_TP_Y_OFFSET    = 3                -- studs arriba del modelo
local STAND_RECHECK_EVERY  = 1                -- cada N stands re-escanea botones
local STAND_FOLDER_PREFIX  = "Lemon"           -- solo folders que empiecen asi (case-insensitive). "" = todos.
local STAND_LOOP_DELAY     = 0.1              -- delay entre pasadas completas
-- Price gating: solo TPea al stand si su precio (PlayerGui.<standName>.Upgrade.Price)
-- es <= a leaderstats.Cash. Si no encuentra el GUI/Price, igual va (failsafe).
local STAND_USE_PRICE_GATE = true
local STAND_REQUIRE_PRICE  = true                   -- true = si no hay GUI/Price, SKIP (no TP)
local STAND_PRICE_PATH     = {"Upgrade", "Price"}  -- ruta relativa al GUI del stand

-- Encuentra una posicion "TPeable" para un Model. Devuelve Vector3 o nil.
local function _modelPivotPos(model)
    -- 1) PrimaryPart
    local pp = nil
    pcall_(function() pp = model.PrimaryPart end)
    if pp then
        local p; pcall_(function() p = pp.Position end)
        if p then return p end
    end
    -- 2) Model:GetPivot() si existe
    local piv
    pcall_(function() piv = model:GetPivot() end)
    if piv then
        local p; pcall_(function() p = piv.Position end)
        if p then return p end
    end
    -- 3) Primer BasePart descendiente
    local desc; pcall_(function() desc = model:GetDescendants() end)
    if desc then
        for _, d in ipairs_(desc) do
            local ok, isBase = pcall_(function() return d:IsA("BasePart") end)
            if ok and isBase then
                local p; pcall_(function() p = d.Position end)
                if p then return p end
            end
        end
    end
    -- 4) GetBoundingBox
    local cf
    pcall_(function() cf = model:GetBoundingBox() end)
    if cf then
        local p; pcall_(function() p = cf.Position end)
        if p then return p end
    end
    return nil
end

-- Detecta el "placeholder" que existe ANTES de comprar el stand:
-- el folder tiene un Model con el mismo nombre, y ese Model solo contiene
-- UN BasePart (tipicamente con su mismo nombre). Cuando el stand existe
-- de verdad, el Model tiene mas hijos (Models internos, multiples Parts,
-- attachments, scripts, etc).
local function _isPlaceholderModel(model)
    if not model then return true end
    local kids; pcall_(function() kids = model:GetChildren() end)
    if not kids or #kids == 0 then return true end
    if #kids > 1 then return false end
    local c = kids[1]
    -- 1 hijo BasePart con el MISMO NOMBRE que el Model -> placeholder clasico.
    -- La carpeta y el Model SIEMPRE existen aunque el stand no haya sido comprado;
    -- lo que distingue un stand "vacio" es que su Model solo tiene UN Part con
    -- exactamente el mismo nombre. Skip inmediato, sin price-gate ni TP.
    local okBase, isBase = pcall_(function() return c:IsA("BasePart") end)
    if okBase and isBase then
        local sameName = false
        pcall_(function() sameName = (c.Name == model.Name) end)
        if sameName then return true end   -- <-- placeholder confirmado
        -- Part con nombre DISTINTO: stand real con un solo Part, NO skippear
        return false
    end
    -- 1 hijo Model -> verificar recursivo (wrappers anidados)
    local okMdl, isMdl = pcall_(function() return c:IsA("Model") end)
    if okMdl and isMdl then return _isPlaceholderModel(c) end
    -- 1 hijo de otra clase (Folder, Configuration, etc.) -> tampoco es stand real
    return true
end

-- Para cada subfolder de Purchases devuelve un Model "principal" del stand.
-- Filtra placeholders (stands que aun no se compraron).
local function _findStandModel(folder)
    -- 1) Hijo directo Model con mismo nombre que el folder
    local kids; pcall_(function() kids = folder:GetChildren() end)
    if kids then
        for _, c in ipairs_(kids) do
            local ok, isModel = pcall_(function() return c:IsA("Model") end)
            if ok and isModel and c.Name == folder.Name then
                if not _isPlaceholderModel(c) then return c end
            end
        end
        -- 2) Cualquier hijo directo Model (no placeholder)
        for _, c in ipairs_(kids) do
            local ok, isModel = pcall_(function() return c:IsA("Model") end)
            if ok and isModel and not _isPlaceholderModel(c) then return c end
        end
    end
    -- 3) Descendiente Model con PrimaryPart (no placeholder)
    local desc; pcall_(function() desc = folder:GetDescendants() end)
    if desc then
        for _, d in ipairs_(desc) do
            local ok, isModel = pcall_(function() return d:IsA("Model") end)
            if ok and isModel then
                local pp; pcall_(function() pp = d.PrimaryPart end)
                if pp and not _isPlaceholderModel(d) then return d end
            end
        end
    end
    return nil
end

-- Lista ordenada {folder, model, pos} de stands TPeables.
-- Filtra folders por STAND_FOLDER_PREFIX (case-insensitive). "" = todos.
local function getStandTargets(verbose)
    local out = {}
    if not myTycoon then
        if verbose then print("[Stand] myTycoon nil") end
        return out
    end
    local purchases
    pcall_(function() purchases = myTycoon:FindFirstChild("Purchases") end)
    if not purchases then
        if verbose then print("[Stand] Purchases folder no encontrado en " .. tostring(myTycoon:GetFullName())) end
        return out
    end
    local kids; pcall_(function() kids = purchases:GetChildren() end)
    if not kids then return out end
    local prefix = (STAND_FOLDER_PREFIX or ""):lower()
    local skipped, noModel, noPos = 0, 0, 0
    for _, folder in ipairs_(kids) do
        local nm = tostring(folder.Name)
        if prefix ~= "" and nm:lower():sub(1, #prefix) ~= prefix then
            skipped = skipped + 1
        else
            local model = _findStandModel(folder)
            if not model then
                noModel = noModel + 1
                if verbose then print("[Stand]   " .. nm .. " -> sin Model") end
            else
                local pos = _modelPivotPos(model)
                if not pos then
                    noPos = noPos + 1
                    if verbose then print("[Stand]   " .. nm .. " -> Model sin pos") end
                else
                    tinsert(out, {folder = folder, model = model, pos = pos, name = nm})
                end
            end
        end
    end
    if verbose then
        print(string.format("[Stand] Purchases hijos=%d  match-prefix=%d  no-model=%d  no-pos=%d  validos=%d",
            #kids, #kids - skipped, noModel, noPos, #out))
    end
    return out
end

