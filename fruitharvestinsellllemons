-- Upgrade). Para los activos hacemos el TP+spam E clasico que ya funciona.
local STAND_MODE = "manage"   -- "manage" = filtro Manage + TP+E, "tp" = legacy
local STAND_MANAGE_PATH = {"Manage", "ManageMenu", "Body", "Frame", "Manage"}
local STAND_MANAGE_BLANK_PREFIX = "Blank"
