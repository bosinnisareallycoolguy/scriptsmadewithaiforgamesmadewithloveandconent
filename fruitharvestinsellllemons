local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local camera = workspace.CurrentCamera
local player = Players.LocalPlayer

setrobloxinput(true)

local lemonFarmActive = false
local autoBuyActive = false
local lockFrom = nil
local lockTarget = nil

local key1Down = false
local key2Down = false
local key9Down = false

-- Find tycoon
local myTycoon = nil
for _, tycoon in pairs(workspace:GetChildren()) do
    if tycoon.Name:find("Tycoon") then
        local owner = tycoon:FindFirstChild("Owner")
        if owner and tostring(owner.Value):find(player.Name) then
            myTycoon = tycoon
            break
        end
    end
end

print("=== Sell Lemons Script ===")
print("1 = Toggle Auto Buy | 2 = Toggle Lemon Farm | 9 = Stop All")
if myTycoon then
    print("Tycoon found: " .. myTycoon.Name)
else
    print("WARNING: Tycoon not found!")
end

RunService.RenderStepped:Connect(function()
    -- Key 1 (keycode 49) = toggle auto buy
    if iskeypressed(49) then
        if not key1Down then
            key1Down = true
            autoBuyActive = not autoBuyActive
            lemonFarmActive = false
            lockFrom = nil
            lockTarget = nil
            print("Auto Buy: " .. (autoBuyActive and "ON" or "OFF"))
        end
    else
        key1Down = false
    end

    -- Key 2 (keycode 50) = toggle lemon farm
    if iskeypressed(50) then
        if not key2Down then
            key2Down = true
            lemonFarmActive = not lemonFarmActive
            autoBuyActive = false
            lockFrom = nil
            lockTarget = nil
            print("Lemon Farm: " .. (lemonFarmActive and "ON" or "OFF"))
        end
    else
        key2Down = false
    end

    -- Key 9 (keycode 57) = stop all
    if iskeypressed(57) then
        if not key9Down then
            key9Down = true
            lemonFarmActive = false
            autoBuyActive = false
            lockFrom = nil
            lockTarget = nil
            print("Everything stopped!")
        end
    else
        key9Down = false
    end

    -- Camera lock for lemon farm
    if lockFrom and lockTarget then
        camera.CFrame = CFrame.lookAt(lockFrom, lockTarget)
    end
end)

-- Main loop
task.spawn(function()
    while true do
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        -- AUTO BUY
        if autoBuyActive and myTycoon and hrp then
            for _, v in pairs(myTycoon:GetDescendants()) do
                if not autoBuyActive then break end
                if v.Name == "Button" and v:IsA("BasePart") then
                    -- Teleport above button first
                    hrp.CFrame = CFrame.new(v.Position.X, v.Position.Y + 2, v.Position.Z)
                    task.wait(0.1)
                    -- Teleport lower to guarantee touch
                    hrp.CFrame = CFrame.new(v.Position.X, v.Position.Y + 1, v.Position.Z)
                    task.wait(0.2)
                end
            end
            print("Buy sweep done!")
            task.wait(1)

        -- LEMON FARM
        elseif lemonFarmActive and hrp then
            for _, v in pairs(workspace:GetDescendants()) do
                if not lemonFarmActive then break end
                if v.Name == "ClickPart" then
                    local fruit = v.Parent
                    local tree = fruit and fruit.Parent

                    -- Disable canopy blocking
                    local modified = {}
                    if tree then
                        for _, part in pairs(tree:GetDescendants()) do
                            if part:IsA("BasePart") and part ~= v then
                                pcall(function()
                                    part.CanQuery = false
                                    table.insert(modified, part)
                                end)
                            end
                        end
                    end

                    -- Teleport below fruit
                    local tpPos = Vector3.new(v.Position.X, v.Position.Y - 8, v.Position.Z)
                    hrp.CFrame = CFrame.new(tpPos.X, tpPos.Y, tpPos.Z)
                    lockFrom = tpPos
                    lockTarget = v.Position
                    task.wait(0.1)

                    -- Click center of screen
                    local center = camera.ViewportSize / 2
                    mousemoveabs(center.X, center.Y)
                    mouse1click()
                    task.wait(0.03)
                    mouse1click()

                    lockFrom = nil
                    lockTarget = nil

                    -- Restore canopy
                    for _, part in pairs(modified) do
                        pcall(function() part.CanQuery = true end)
                    end

                    task.wait(0.03)
                end
            end
            print("Lemon sweep done!")
            task.wait(0.5)

        else
            task.wait(0.1)
        end
    end
end)
