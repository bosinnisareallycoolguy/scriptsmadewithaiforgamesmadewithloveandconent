local function posKey(pos)
    return math.floor(pos.X + 0.5) .. "," .. math.floor(pos.Y + 0.5) .. "," .. math.floor(pos.Z + 0.5)
end

-- Helper to normalize Color3 properties to 0-255 scale
local function normalizeColor(c)
    local r, g, b = c.R, c.G, c.B
    if r <= 1 and g <= 1 and b <= 1 then
        r = r * 255
        g = g * 255
        b = b * 255
    end
    return r, g, b
end

-- Helper to check if a button is greyed out/unaffordable
local function isGreyedOut(v)
    local success, color3 = pcall(function() return v.Color end)
    if not success or not color3 then
        return false
    end
    
    local r, g, b = normalizeColor(color3)
    local diff1 = math.abs(r - g)
    local diff2 = math.abs(g - b)
    local diff3 = math.abs(r - b)
    
    -- If R, G, B are close to each other (within 30 points) and not too bright white (R < 200)
    if diff1 < 30 and diff2 < 30 and diff3 < 30 and r < 200 then
        return true
    end
    
    return false
end

-- Smartly detect and cache the specific folder containing tycoon buttons
local buttonsContainer = nil
local lastContainerScan = 0

local function getButtonsContainer(tycoon)
    if buttonsContainer and buttonsContainer:IsDescendantOf(tycoon) then
        return buttonsContainer
    end

    local now = tick()
    -- Only run the heavy descendant scan once every 3 seconds if not cached yet
    if (now - lastContainerScan) < 3.0 then
        return tycoon
    end
    lastContainerScan = now

    -- 1. Try to find a folder/model by name under tycoon
    for _, child in ipairs(tycoon:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            local name = child.Name:lower()
            if name:find("button") or name:find("purchase") or name:find("buy") then
                buttonsContainer = child
                print("[Debug] Detected buttons container by name: " .. child:GetFullName())
                return child
            end
        end
    end

    -- 2. Find any button and trace back its highest parent container under the tycoon
    for _, v in pairs(tycoon:GetDescendants()) do
        if v.Name == "Button" and v:IsA("BasePart") then
            local p = v.Parent
            local ancestor = p
            while ancestor and ancestor.Parent and ancestor.Parent ~= tycoon and ancestor.Parent ~= workspace do
                ancestor = ancestor.Parent
            end
            if ancestor and ancestor ~= tycoon then
                buttonsContainer = ancestor
                print("[Debug] Detected buttons container by button: " .. ancestor:GetFullName())
                return ancestor
            end
        end
    end

    return tycoon
end

-- Cache to avoid calling GetDescendants() every single frame
local cachedButtons = {}
local lastScanTime = 0
local needsRescan = true

local function getButtons(tycoon)
    local now = tick()
    -- Re-scan if forced, if cache is empty (throttle to 1s), or if 5 seconds have passed
    local shouldScan = needsRescan 
        or ((#cachedButtons == 0) and (now - lastScanTime) > 1.0)
        or ((now - lastScanTime) > 5.0)

    if shouldScan then
        needsRescan = false
        lastScanTime = now
        
        local container = getButtonsContainer(tycoon)
        local buttons = {}
        -- If container is tycoon itself, scan children; otherwise scan descendants
        local searchList = (container == tycoon) and container:GetChildren() or container:GetDescendants()
        
        for _, v in pairs(searchList) do
            if v and v.Parent and v.Name == "Button" and v:IsA("BasePart") then
                table.insert(buttons, v)
            end
        end
        cachedButtons = buttons
    end

    -- Return only buttons that still exist in the workspace
    local activeButtons = {}
    local activeKeys = {}
    for _, btn in ipairs(cachedButtons) do
        if btn and btn.Parent and btn:IsDescendantOf(tycoon) then
            table.insert(activeButtons, btn)
            activeKeys[posKey(btn.Position)] = true
        end
    end

    -- Clean up cooldowns for buttons that were successfully bought
    for k, _ in pairs(failedButtons) do
        if not activeKeys[k] then
            failedButtons[k] = nil
        end
    end

    return activeButtons
end

-- Helper to check if a button is on cooldown and return remaining time
local function getCooldownRemaining(key)
    local data = failedButtons[key]
    if not data then return 0 end
    
    local elapsed = tick() - data.lastTry
    local limit = (data.tries >= 2) and 4.0 or 0.3 -- 0.3s for first try, 4s for actual failures
    return limit - elapsed
end

local function findBestButton(tycoon, hrp)
    if not tycoon or not hrp then return nil end

    local best = nil
    local bestDist = math.huge
    local buttons = getButtons(tycoon)

    for _, v in ipairs(buttons) do
        local exists = false
        pcall(function()
            exists = v and v.Parent and v:IsDescendantOf(tycoon)
        end)
        
        if exists then
            local key = posKey(v.Position)
            local cooldownActive = getCooldownRemaining(key) > 0
            local grey = isGreyedOut(v)

            -- Skip buttons that are on cooldown or greyed out
            if not cooldownActive and not grey then
                local dist = (v.Position - hrp.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    best = v
                end
            end
        end
    end
    
    return best
end

