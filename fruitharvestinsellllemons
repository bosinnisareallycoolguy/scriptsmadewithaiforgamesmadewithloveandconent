task.spawn(function()
    while _G.SellLemonsActive do
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        -- Re-find tycoon periodically in case reference went stale
        if autoBuyActive and not myTycoon then
            myTycoon = getTycoon()
        end

        -- AUTO BUY: one button at a time, re-scan after each
        if autoBuyActive and myTycoon and hrp then
            local button = findBestButton(myTycoon, hrp)

            if button then
                local key = posKey(button.Position)

                pcall(function()
                    if button and button.Parent and button:IsDescendantOf(myTycoon) then
                        local colorStr = "Unknown"
                        pcall(function() 
                            colorStr = string.format("RGB(%.0f, %.0f, %.0f)", button.Color.R, button.Color.G, button.Color.B) 
                        end)
                        print("Buying: " .. button.Name .. " | Color: " .. colorStr)
                        
                        -- Two-step teleport drop to ensure Roblox physics registers the Touch event
                        hrp.CFrame = CFrame.new(button.Position.X, button.Position.Y + 3.0, button.Position.Z)
                        task.wait(0.04)
                        hrp.CFrame = CFrame.new(button.Position.X, button.Position.Y + 1.0, button.Position.Z)
                        task.wait(0.04)
                    end
                end)

                -- Check if the button was bought (it should be gone)
                task.wait(0.04)
                local stillExists = false
                pcall(function()
                    stillExists = button and button.Parent and button:IsDescendantOf(myTycoon)
                end)

                if stillExists then
                    -- Button didn't get bought — probably can't afford it
                    failedButtons[key] = (failedButtons[key] or 0) + 1
                else
                    -- Button was successfully bought!
                    failedButtons[key] = nil
                    
                    -- Safe decay of existing fails
                    local updatedFails = {}
                    for k, v in pairs(failedButtons) do
                        updatedFails[k] = math.max(0, v - 1)
                    end
                    failedButtons = updatedFails
                end
            else
                -- No buyable buttons found
                failedButtons = {}
                myTycoon = getTycoon()
                task.wait(0.2)
            end

            task.wait(0.02)

        -- LEMON FARM
        elseif lemonFarmActive and hrp then
            local count = 0
            for _, v in pairs(workspace:GetDescendants()) do
                if not lemonFarmActive then break end
                
                count = count + 1
                if count % 200 == 0 then
                    task.wait()
                end

                if v.Name == "ClickPart" then
                    local fruit = v.Parent
                    local tree = fruit and fruit.Parent

                    local modified = {}
                    if tree then
                        for _, part in pairs(tree:GetDescendants()) do
                            if part:IsA("BasePart") and part ~= v then
                                pcall(function()
                                    part.CanQuery = false
                                    table.insert(modified, part)
                                end)
                            end
                        end
                    end

                    if not v or not v:IsDescendantOf(workspace) then continue end

                    local tpPos = Vector3.new(v.Position.X, v.Position.Y - 4, v.Position.Z)
                    hrp.CFrame = CFrame.new(tpPos.X, tpPos.Y, tpPos.Z)
                    task.wait(0.05)

                    camera.lookAt(tpPos, v.Position)
                    task.wait(0.05)

                    local cx = math.floor(camera.ViewportSize.X / 2)
                    local cy = math.floor(camera.ViewportSize.Y / 2)
                    mousemoveabs(cx, cy)
                    mouse1click()
                    task.wait(0.03)
                    mouse1click()

                    for _, part in pairs(modified) do
                        pcall(function() part.CanQuery = true end)
                    end

                    task.wait(0.03)
                end
            end
            print("Lemon sweep done!")
            task.wait(0.5)

        else
            task.wait(0.1)
        end
    end
end)
