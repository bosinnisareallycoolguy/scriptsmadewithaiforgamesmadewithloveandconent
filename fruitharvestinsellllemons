            for i = 1, count do
                if not cashFarmActive then break end
                local parent = snapshot[i]
                if parent and parent.Parent then
                    pcall_(function() parent.Position = headPos end)
                end
            end
            task_wait(0.3)
        else
            task_wait(0.2)
        end
    end
end)

