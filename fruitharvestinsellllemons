-- Devuelve lista {frame, upgrade, name, priceText} de stands desbloqueados.
-- Skippea Blank* (slots vacios) y todo lo que no tenga Upgrade GuiButton.
local function _getManageStands()
    local out = {}
    local root = _getManageRoot()
    if not root then return out end
    local kids; pcall_(function() kids = root:GetChildren() end)
    if not kids then return out end
    for _, c in ipairs_(kids) do
        local okF, isFrame = pcall_(function() return c:IsA("Frame") end)
        if okF and isFrame then
            local nm = tostring(c.Name)
            if nm:sub(1, #STAND_MANAGE_BLANK_PREFIX) ~= STAND_MANAGE_BLANK_PREFIX then
                local upg; pcall_(function() upg = c:FindFirstChild("Upgrade") end)
                if upg then
                    local okBtn, isBtn = pcall_(function() return upg:IsA("GuiButton") end)
                    if okBtn and isBtn then
                        local priceLbl; pcall_(function() priceLbl = upg:FindFirstChild("Price") end)
                        local priceText = nil
                        if priceLbl then pcall_(function() priceText = priceLbl.Text end) end
                        tinsert(out, {frame=c, upgrade=upg, name=nm, priceText=priceText})
                    end
                end
            end
        end
    end
    return out
end

-- Click programatico sobre un GuiButton. Combina:
--  (a) firesignal sobre Activated y MouseButton1Click (si el ejecutor lo expone)
--  (b) VirtualInputManager:SendMouseButtonEvent en el centro absoluto del boton
local function _clickGuiButton(btn)
    if not btn or not btn.Parent then return false end
    local fired = false
    if type(firesignal) == "function" then
        pcall_(function()
            if btn.Activated then
                firesignal(btn.Activated, Enum.UserInputType.MouseButton1)
                fired = true
            end
        end)
        pcall_(function()
            if btn.MouseButton1Click then
                firesignal(btn.MouseButton1Click)
                fired = true
            end
        end)
    end
    if VIM_svc then
        local pos, size
        pcall_(function() pos, size = btn.AbsolutePosition, btn.AbsoluteSize end)
        if pos and size and size.X > 0 and size.Y > 0 then
            local cx = pos.X + size.X * 0.5
            local cy = pos.Y + size.Y * 0.5
            pcall_(function()
                VIM_svc:SendMouseButtonEvent(cx, cy, 0, true,  game, 0)
                VIM_svc:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                fired = true
            end)
        end
    end
    return fired
end

-- Una pasada por todos los stands del ManageMenu (modo hibrido).
-- 1) Lee BackgroundColor3 por memoria (memory_read addr+0x540).
--    Gris ~(0.49,0.49,0.49) -> INACTIVO, skip sin TP.
--    Cualquier otro color  -> ACTIVO, TP + spam E.
-- 2) Si memory_read no funciona para ese boton, fallback al delta detector
--    (compara Count/Price antes y despues; cachea inactivos 8s).
local function runManagePass(verbose)
    local stands = _getManageStands()
    if #stands == 0 then
        if verbose then
            print("[Stand][Manage+TP] Manage no encontrado o vacio. Abri el menu Manage al menos una vez.")
        end
        return "done"
    end
    print(sformat("[Stand][Manage+TP] Pasada start, %d desbloqueados", #stands))
    local tapped, skipped_color, skipped_cache, fallback_used = 0, 0, 0, 0
    for i, s in ipairs_(stands) do
        -- v5.17.3: solo chequeamos autoStandActive. Antes pedia tambien
        -- autoBuyActive, lo que hacia que runManagePass se ejecutara y saliera
        -- silenciosamente cuando AutoBuy estaba OFF -> 1111 "Pasada start" sin
        -- "Pasada end" y un loop al 20Hz. El gating con AutoBuy ya lo hace el
        -- driver exterior (linea ~2040: if autoBuyActive and _anyLiveButtons()).
        if not autoStandActive then return "off" end
        if (i - 1) % STAND_RECHECK_EVERY == 0 then
            if _anyLiveButtons() then
                print("[Stand][Manage+TP] Boton vivo detectado, saliendo")
                return "buttons"
            end
        end
        -- (A) Chequeo por color via memoria
        local active, cr, cg, cb = _isUpgradeActive(s.upgrade)
        if active == false then
            skipped_color = skipped_color + 1
            if verbose then
                print(sformat("[Stand][Manage+TP] [%d/%d] %s -> INACTIVO (gris %.2f,%.2f,%.2f)",
                    i, #stands, tostring(s.name), cr or 0, cg or 0, cb or 0))
            end
            task_wait(0.005)
            continue
        end
        -- (B) Si pudimos leer color y es ACTIVO -> TP+E directo
        -- (C) Si no pudimos leer color (active == nil) -> fallback delta con cache 8s
        local useFallback = (active == nil)
        if useFallback then
            fallback_used = fallback_used + 1
            if _shouldSkipInactive(s.name) then
                skipped_cache = skipped_cache + 1
                task_wait(0.005)
                continue
            end
        end
        -- Resolver folder/modelo/pos
        local folder = _findPurchaseFolderForStand(s.name)
        if not folder then
            print(sformat("[Stand][Manage+TP] [%d/%d] %s -> no Purchases match",
                i, #stands, tostring(s.name)))
            task_wait(STAND_CYCLE_PAUSE)
            continue
        end
        local model = _findStandModel(folder)
        local pos   = model and _modelPivotPos(model) or nil
        if not pos then
            print(sformat("[Stand][Manage+TP] [%d/%d] %s -> sin pos TPeable",
                i, #stands, tostring(s.name)))
            task_wait(STAND_CYCLE_PAUSE)
            continue
        end
        -- Estado antes (solo si usamos fallback)
        local before = useFallback and _readUpgradeState(s.upgrade) or nil
        -- TP + spam E
        if not _tpHrpTo(pos) then
            print(sformat("[Stand][Manage+TP] [%d/%d] %s -> TP fallo",
                i, #stands, tostring(s.name)))
            task_wait(STAND_CYCLE_PAUSE)
            continue
        end
        task_wait(STAND_TP_SETTLE)
        _spamKeyFor(STAND_KEY, STAND_E_SPAM_DURATION, STAND_E_SPAM_INTERVAL)
        tapped = tapped + 1
        if useFallback then
            local after = _readUpgradeState(s.upgrade)
            if before == after then
                _markInactive(s.name)
                print(sformat("[Stand][Manage+TP] [%d/%d] %s -> [fallback] sin cambio, INACTIVO %ds",
                    i, #stands, tostring(s.name), STAND_INACTIVE_RETEST_AFTER))
            else
                _markActive(s.name)
                print(sformat("[Stand][Manage+TP] [%d/%d] %s -> [fallback] COMPRO! (%s->%s)",
                    i, #stands, tostring(s.name), tostring(before), tostring(after)))
            end
        else
            print(sformat("[Stand][Manage+TP] [%d/%d] %s -> ACTIVO TP+E %.1fs (color %.2f,%.2f,%.2f)",
                i, #stands, tostring(s.name), STAND_E_SPAM_DURATION, cr or 0, cg or 0, cb or 0))
        end
        task_wait(STAND_CYCLE_PAUSE)
    end
    print(sformat("[Stand][Manage+TP] Pasada end. tap=%d skip_color=%d skip_cache=%d fallback=%d",
        tapped, skipped_color, skipped_cache, fallback_used))
    return "done"
end

-- Una pasada por todos los stands. Devuelve "buttons" si reaparecio uno,
-- "off" si el usuario apago, "done" si termino la pasada sin novedades.
local function runStandPass(verbose)
    local targets = getStandTargets(verbose)
    if #targets == 0 then return "done" end
    -- Leer cash una vez por pasada (se re-lee si una compra cambia el monto;
    -- ojo: si el upgrade restara cash, conviene re-leerlo entre stands).
    local cash = STAND_USE_PRICE_GATE and _getCash() or nil
    print(string.format("[Stand] Pasada start, %d stands  cash=%s",
        #targets, tostring(cash)))
    local skipped_price, tapped = 0, 0
    for i, t in ipairs_(targets) do
        -- v5.17.3: igual que el Manage pass, no requerimos autoBuyActive aca.
        -- El driver exterior ya gatea con Auto Buy live buttons.
        if not autoStandActive then return "off" end
        -- Re-check botones cada STAND_RECHECK_EVERY stands
        if (i - 1) % STAND_RECHECK_EVERY == 0 then
            -- v5.17.4: igual que Manage pass, checkear solo si AutoBuy activo.
            if autoBuyActive and _anyLiveButtons() then
                print("[Stand] Boton vivo detectado, saliendo del modo stand")
                return "buttons"
            end
        end
        -- Price gating fail-closed: si no hay GUI/Price o cash < price -> SKIP.
        -- Si STAND_REQUIRE_PRICE=false, sin GUI/Price igual TPea (modo permisivo).
        if STAND_USE_PRICE_GATE then
            local gui = _resolveStandGui(t.name)
            local price = _getStandPrice(t.name, true)
            cash = _getCash() or cash
            local reason = nil
            if not gui then
                if STAND_REQUIRE_PRICE then reason = "no GUI en PlayerGui" end
            elseif not price then
                if STAND_REQUIRE_PRICE then reason = "no price parseable" end
            elseif not cash then
                reason = "no leaderstats.Cash"
            elseif cash < price then
                reason = sformat("precio=%s > cash=%s", tostring(price), tostring(cash))
            end
            if reason then
                skipped_price = skipped_price + 1
                print(sformat("[Stand] [%d/%d] %s -> SKIP (%s)",
                    i, #targets, tostring(t.name), reason))
                task_wait(STAND_CYCLE_PAUSE)
                continue
            end
        end
        -- TP + tap E (instantaneo)
        if _tpHrpTo(t.pos) then
            task_wait(STAND_TP_SETTLE)
            if STAND_PRESSES <= 1 then
                _tapKeyOnce(STAND_KEY)
            else
                _pressKeyMany(STAND_KEY, STAND_PRESSES)
            end
            tapped = tapped + 1
            print(string.format("[Stand] [%d/%d] %s -> E tap",
                i, #targets, tostring(t.name)))
        else
            print("[Stand] [" .. tostring(i) .. "/" .. #targets .. "] TP fallo en " .. tostring(t.name))
        end
        task_wait(STAND_CYCLE_PAUSE)
    end
    print(string.format("[Stand] Pasada end. tap=%d  skip_precio=%d", tapped, skipped_price))
    return "done"
end

