-- Track buttons we've failed to buy so we skip them
local failedButtons = {} -- [posKey] = failCount

local function getTycoon()
    for _, tycoon in pairs(workspace:GetChildren()) do
        if tycoon.Name:find("Tycoon") then
            local owner = tycoon:FindFirstChild("Owner")
            if owner and tostring(owner.Value):find(player.Name) then
                return tycoon
            end
        end
    end
    return nil
end

local myTycoon = getTycoon()

local function posKey(pos)
    return math.floor(pos.X + 0.5) .. "," .. math.floor(pos.Y + 0.5) .. "," .. math.floor(pos.Z + 0.5)
end

-- Helper to check if a button is greyed out/unaffordable
local function isGreyedOut(v)
    -- Safely read the Color property (Color3)
    local success, color3 = pcall(function() return v.Color end)
    if not success or not color3 then
        return false -- Default to false (not greyed out) if we can't read it
    end
    
    local c = color3
    local diff1 = math.abs(c.R - c.G)
    local diff2 = math.abs(c.G - c.B)
    local diff3 = math.abs(c.R - c.B)
    
    -- If R, G, B are close to each other (within 30 points) and not too bright white (R < 200)
    if diff1 < 30 and diff2 < 30 and diff3 < 30 and c.R < 200 then
        return true
    end
    
    return false
end

-- Cache to avoid calling GetDescendants() every single frame
local cachedButtons = {}
local lastScanTime = 0

local function getButtons(tycoon)
    local now = tick()
    -- Re-scan only if cache is empty or 1.5 seconds have passed
    if #cachedButtons == 0 or (now - lastScanTime) > 1.5 then
        local buttons = {}
        for _, v in pairs(tycoon:GetDescendants()) do
            if v and v.Parent and v.Name == "Button" and v:IsA("BasePart") then
                table.insert(buttons, v)
            end
        end
        cachedButtons = buttons
        lastScanTime = now
    end

    -- Return only buttons that still exist in the workspace
    local activeButtons = {}
    for _, btn in ipairs(cachedButtons) do
        if btn and btn.Parent and btn:IsDescendantOf(tycoon) then
            table.insert(activeButtons, btn)
        end
    end
    return activeButtons
end

local function findBestButton(tycoon, hrp)
    if not tycoon or not hrp then return nil end

    local best = nil
    local bestDist = math.huge
    local buttons = getButtons(tycoon)

    for _, v in ipairs(buttons) do
        local exists = false
        pcall(function()
            exists = v and v.Parent and v:IsDescendantOf(tycoon)
        end)
        
        if exists then
            local key = posKey(v.Position)
            local fails = failedButtons[key] or 0

            local grey = isGreyedOut(v)

            -- Skip buttons we've failed 2+ times, or if they are greyed out
            if fails < 2 and not grey then
                local dist = (v.Position - hrp.Position).Magnitude
                if fails == 0 then
                    dist = dist * 0.1 -- heavily prioritize untried buttons
                end

                if dist < bestDist then
                    bestDist = dist
                    best = v
                end
            end
        end
    end
    
    return best
end

