-- ==================== LEMON FARM ====================
-- Anti-stuck: registra intentos por limón (por posición). Si un limón falla N veces
-- consecutivas, se marca como inalcanzable temporalmente para no bloquear la pasada.
local lemonFailCount  = {}   -- [posKey] = nº de intentos fallidos consecutivos
local LEMON_MAX_FAILS = 3    -- tras este nº, se ignora durante el ciclo actual
local LEMON_MAX_PASSES = 6   -- tope de re-escaneos por ciclo (seguridad)

-- HITBOX EXPANSION: agranda el ClickPart antes del click para que el cursor
-- pegue aunque la cámara esté ligeramente desalineada. Se restaura al terminar.
local LEMON_HITBOX_ENABLED = true
local LEMON_HITBOX_SIZE    = Vec3(50, 50, 50)   -- 50x50x50 studs (ajustable)

-- ====== TUNING DE VELOCIDAD (bajalos si quieres mas velocidad) ======
local LEMON_TP_WAIT      = 0.008  -- espera tras teleport
local LEMON_CAM_WAIT     = 0.008  -- espera tras lookAt
local LEMON_CLICK_GAP    = 0.005  -- entre el 1er y 2do click
local LEMON_POST_WAIT    = 0      -- espera al cerrar la fruta (0 = sin pausa)
local LEMON_PASS_WAIT    = 0.04   -- entre pasadas (antes 0.08)
local LEMON_DOUBLE_CLICK = true   -- false = solo 1 click (~15% mas rapido)

local function lemonKey(v)
    local pos = v.Position
    return mfloor(pos.X + 0.5) .. "," .. mfloor(pos.Y + 0.5) .. "," .. mfloor(pos.Z + 0.5)
end

-- ====== TREE GROUPING ======
-- En lugar de manipular CanQuery por cada fruta (lo cual recorre tree:GetDescendants()
-- N veces), agrupamos las frutas por arbol y hacemos el setup/teardown UNA sola vez
-- por arbol. En arboles densos esto es 5-20x menos trabajo.

local function findTreeOf(clickPart)
    -- ClickPart -> Fruit -> LemonTree (o el ancestor mas cercano nombrado "Tree*" o "LemonTree")
    local n = clickPart.Parent              -- Fruit
    if n then return n.Parent end           -- LemonTree
    return nil
end

local function disableTreeCanQuery(tree, excludeSet)
    -- Pone CanQuery=false en todos los descendientes del arbol EXCEPTO los ClickParts
    -- que vamos a clickear (estos siguen necesitando ser raycast-eables).
    local modified, n = {}, 0
    for _, part in ipairs_(tree:GetDescendants()) do
        if part:IsA("BasePart") and not excludeSet[part] then
            pcall_(function()
                if part.CanQuery then
                    part.CanQuery = false
                    n = n + 1
                    modified[n] = part
                end
            end)
        end
    end
    return modified, n
end

local function restoreTreeCanQuery(modified, n)
    for i = 1, n do
        local part = modified[i]
        pcall_(function() part.CanQuery = true end)
    end
end

-- Procesa una sola fruta (sin tocar CanQuery -- eso se hace por arbol afuera)
local function processLemon(v, hrp)
    if not v or not v:IsDescendantOf(Workspace) then return false end

    -- HITBOX EXPANSION
    local origSize, origTransp, origCanColl = nil, nil, nil
    local hitboxApplied = false
    if LEMON_HITBOX_ENABLED then
        pcall_(function()
            origSize    = v.Size
            origTransp  = v.Transparency
            origCanColl = v.CanCollide
            v.CanCollide   = false
            v.Transparency = 1
            v.Size         = LEMON_HITBOX_SIZE
            hitboxApplied  = true
        end)
    end

    local vp = v.Position
    local tpX, tpY, tpZ = vp.X, vp.Y - 4, vp.Z
    hrp.CFrame = CF(tpX, tpY, tpZ)
    task_wait(LEMON_TP_WAIT)

    camera.lookAt(Vec3(tpX, tpY, tpZ), vp)
    task_wait(LEMON_CAM_WAIT)

    local vps = camera.ViewportSize
    local cx  = mfloor(vps.X / 2)
    local cy  = mfloor(vps.Y / 2)
    mousemoveabs(cx, cy)
    mouse1click()
    if LEMON_DOUBLE_CLICK then
        task_wait(LEMON_CLICK_GAP)
        mouse1click()
    end

    local collected = not (v and v.Parent and v:IsDescendantOf(Workspace))

    if hitboxApplied and not collected then
        pcall_(function()
            if origSize    ~= nil then v.Size         = origSize    end
            if origTransp  ~= nil then v.Transparency = origTransp  end
            if origCanColl ~= nil then v.CanCollide   = origCanColl end
        end)
    end

    if LEMON_POST_WAIT > 0 then task_wait(LEMON_POST_WAIT) end
    return collected
end

-- ====== VERIFY PASS TUNING ======
-- Cuando el bucle principal termina (count==0, sameCountStreak o LEMON_MAX_PASSES)
-- corremos pasadas de "verificacion" con failCount limpio para recoger frutas
-- que se hayan salteado por posicion, timing del server o fallos previos.
local LEMON_VERIFY_WAIT       = 0.15  -- pausa antes de re-verificar (server settle)
local LEMON_VERIFY_MAX_PASSES = 3     -- max pasadas de verificacion seguidas

-- Procesa un snapshot completo agrupando por arbol (extraido del loop principal
-- para reusar en las pasadas de verificacion).
local function processSnapshot(snapshot, hrp)
    local count = #snapshot
    if count == 0 then return 0 end

    local groups, groupOrder = {}, {}
    for i = 1, count do
        local v = snapshot[i]
        if v and v:IsDescendantOf(Workspace) then
            local tree = findTreeOf(v) or v.Parent
            local g = groups[tree]
            if not g then
                g = {}
                groups[tree] = g
                tinsert(groupOrder, tree)
            end
            tinsert(g, v)
        end
    end

    local collectedCount = 0
    for _, tree in ipairs_(groupOrder) do
        if not lemonFarmActive then break end
        local fruits = groups[tree]
        local excludeSet = {}
        for i = 1, #fruits do excludeSet[fruits[i]] = true end

        local modified, modN
        if tree then
            modified, modN = disableTreeCanQuery(tree, excludeSet)
        else
            modified, modN = {}, 0
        end

        for i = 1, #fruits do
            if not lemonFarmActive then break end
            local v = fruits[i]
            if v and v:IsDescendantOf(Workspace) then
                local lk    = lemonKey(v)
                local fails = lemonFailCount[lk] or 0
                if fails < LEMON_MAX_FAILS then
                    local ok = processLemon(v, hrp)
                    if ok then
                        lemonFailCount[lk] = nil
                        collectedCount = collectedCount + 1
                    else
                        lemonFailCount[lk] = fails + 1
                    end
                end
            end
        end

        if modN > 0 then restoreTreeCanQuery(modified, modN) end
    end
    return collectedCount
end

