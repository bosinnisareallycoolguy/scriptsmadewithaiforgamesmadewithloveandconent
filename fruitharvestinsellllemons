                            elseif key == "LemonFarm" and not f.value then
                                for j = 1, #F do
                                    local ff = F[j]
                                    if ff.key == "AutoBuy" then ff.value = false end
                                end
                            end
                            f.value = not f.value
                            syncFromUI()
                            print("[Hub] TOGGLED: " .. key .. " = " .. tostring_(f.value))
                        elseif kind == "action" then
                            print("[Hub] ACTION: " .. f.key)
                            if f.key == "StopAll" then stopAll() end
                        end
                    end
                end
            end

            if mx >= upx and mx <= upx + usx and my >= upy and my <= upy + 30 then
                dragging = true
                dragOff  = Vec2(mx - upx, my - upy)
            end
        end

        if dragging then
            if m1 then
                uiPos = Vec2(mx - dragOff.X, my - dragOff.Y)
            else
                dragging = false
            end
        end

        lastM1 = m1
        pcall_(Render)
    end
end)

-- ==================== AUTO STAND standalone loop ====================
-- Corre independiente de AUTO BUY. Si AUTO BUY esta activo y hay botones vivos,
-- cede el paso (no spamea para no chocar con el TP de compras). Si no, corre
-- pasadas continuas TPeando a cada stand y spameando E.
task_spawn(function()
    local lastDiag = 0
    local firstRun = true
    while ScriptActive do
        syncFromUI()
        if not autoStandActive then
            firstRun = true
            task_wait(0.25)
            continue
        end

        -- Asegurar tycoon
        if not myTycoon or not myTycoon.Parent then
            myTycoon = findMyTycoon()
            if not myTycoon then
                if tick_() - lastDiag > 3 then
                    print("[Stand] esperando tycoon...")
                    lastDiag = tick_()
                end
                task_wait(0.5)
                continue
            end
        end

        -- Si AUTO BUY esta corriendo y todavia hay botones vivos, cedele el paso
        if autoBuyActive and _anyLiveButtons() then
            task_wait(0.3)
            continue
        end

        -- Pasada de stands. Manage mode (click directo) o TP mode (legacy).
        local res
        if STAND_MODE == "manage" then
            res = runManagePass(firstRun)
            -- Fallback automatico: si Manage esta vacio, probamos TP.
            if res == "done" and #_getManageStands() == 0 then
                if firstRun then
                    print("[Stand] Manage vacio, fallback a TP-mode esta pasada")
                end
                res = runStandPass(firstRun)
            end
        else
            res = runStandPass(firstRun)
        end
        firstRun = false
        if res == "off" then
            task_wait(0.05)
            continue
        end
        task_wait(STAND_LOOP_DELAY)
    end
end)

