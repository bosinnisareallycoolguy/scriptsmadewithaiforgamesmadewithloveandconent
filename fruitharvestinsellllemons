-- Spamea la tecla `key` durante `durationSec` segundos. Sale antes si autoStand
-- se apaga o se pierde el foco.
-- v5.17.0: path optimizado para VK_E (0x45) con cadencia ~28 presses/seg
-- medida en Matcha (17ms hold + 18ms gap, sin doble release, con mouse focus
-- previo y cleanup defensivo). Para otras teclas mantiene el comportamiento
-- original frame-por-frame.
local function _spamKeyFor(key, durationSec, intervalSec)
    -- ========== PATH OPTIMIZADO PARA E (DIAG v5.17.1) ==========
    if key == 0x45 then
        -- v5.17.3: HACEMOS MOUSE FOCUS PRIMERO, despues chequeamos foco.
        -- Antes chequeabamos foco PRIMERO y si daba false (caso comun despues
        -- del TP), bailabamos sin intentar restaurarlo.
        -- Ademas usamos mousemoveabs como hace Auto Buy: sin eso el click cae
        -- donde sea que este el cursor, posiblemente fuera del window de Roblox,
        -- y no restaura foco.
        local function _restoreFocus()
            pcall_(function()
                if camera and type(mousemoveabs) == "function" and type(mouse1press) == "function" then
                    local vp = camera.ViewportSize
                    if vp and vp.X > 0 and vp.Y > 0 then
                        mousemoveabs(mfloor(vp.X * 0.5), mfloor(vp.Y * 0.5))
                        task_wait(0.01)
                        mouse1press()
                        task_wait(0.02)
                        mouse1release()
                    end
                end
            end)
        end

        -- Restaurar foco antes de cualquier chequeo
        _restoreFocus()
        task_wait(0.03)

        local _entry_focus = _windowFocused()
        local _entry_active = autoStandActive
        print(sformat("[E-DIAG] >>> ENTRY focus=%s autoStandActive=%s dur=%.2fs",
            tostring(_entry_focus), tostring(_entry_active), durationSec or 0))

        if not _entry_focus then
            -- Segundo intento: el primer click puede haber sido en una zona muerta
            _restoreFocus()
            task_wait(0.05)
            _entry_focus = _windowFocused()
            print(sformat("[E-DIAG] retry focus after 2nd click: %s", tostring(_entry_focus)))
            if not _entry_focus then
                print("[E-DIAG] BAIL entry: window not focused (isrbxactive=false)")
                task_wait(0.2)
                return false
            end
        end
        -- 1) Cleanup previo
        for i = 1, 2 do
            pcall_(function() keyrelease(0x45) end)
            task_wait(0.012)
        end

        local _post_mouse_focus = _windowFocused()
        print(sformat("[E-DIAG] post-mouse-click focus=%s", tostring(_post_mouse_focus)))

        -- 2) Spam loop con logging
        local t0 = tick_()
        local cycles = 0
        local exit_reason = "duration_completed"

        while true do
            if not autoStandActive then
                exit_reason = sformat("autoStandActive=false at cycle %d", cycles)
                break
            end
            local elapsed = tick_() - t0
            if elapsed >= durationSec then
                break
            end
            if not _windowFocused() then
                exit_reason = sformat("focus_lost at cycle %d t=%.3fs", cycles, elapsed)
                pcall_(function() keyrelease(0x45) end)
                break
            end
            pcall_(function() keypress(0x45) end)
            task_wait(0.017)
            pcall_(function() keyrelease(0x45) end)
            task_wait(0.018)
            cycles = cycles + 1
        end

        pcall_(function() keyrelease(0x45) end)
        print(sformat("[E-DIAG] <<< EXIT cycles=%d reason=%s elapsed=%.3fs",
            cycles, exit_reason, tick_() - t0))
        return true
    end

    -- ========== PATH ORIGINAL PARA OTRAS TECLAS ==========
    local t0 = tick_()
    while autoStandActive and (tick_() - t0) < durationSec do
        if not _windowFocused() then
            task_wait(0.2)
            return false
        end
        pcall_(function() keypress(key) end)
        task_wait()  -- 1 frame
        pcall_(function() keyrelease(key) end)
        if intervalSec and intervalSec > 0 then
            task_wait(intervalSec)
        else
            task_wait()
        end
    end
    return true
end

-- Click programatico via mouse virtual (no requiere hooks).
-- Devuelve true si pudo disparar el click, false si no.
local function _clickGuiButton(btn)
    if not btn or not btn.Parent then return false, "sin parent" end
    -- Si el boton esta desactivado por el juego (Active=false), no clickear.
    local active = true
    pcall_(function() active = btn.Active end)
    if active == false then return false, "Active=false" end
    -- Calcular centro absoluto
    local pos, size
    pcall_(function() pos, size = btn.AbsolutePosition, btn.AbsoluteSize end)
    if not pos or not size or size.X <= 0 or size.Y <= 0 then
        return false, "sin AbsoluteSize"
    end
    -- Si esta dentro de un ScrollingFrame, asegurar visibilidad primero
    _ensureVisibleInScroll(btn)
    -- Re-leer posicion despues del scroll
    pcall_(function() pos, size = btn.AbsolutePosition, btn.AbsoluteSize end)
    local cx = pos.X + size.X * 0.5
    local cy = pos.Y + size.Y * 0.5
    -- Check basico: dentro de la pantalla
    local viewport = camera and camera.ViewportSize
    if viewport and (cx < 0 or cy < 0 or cx > viewport.X or cy > viewport.Y) then
        return false, sformat("fuera de pantalla (%d,%d)", cx, cy)
    end
    if type(mousemoveabs) ~= "function" or type(mouse1press) ~= "function"
       or type(mouse1release) ~= "function" then
        return false, "sin mouse API"
    end
    if not _windowFocused() then return false, "window sin foco" end
    -- Mover, esperar 1 frame, press + 1 frame + release
    pcall_(function() mousemoveabs(cx, cy) end)
    task_wait()
    pcall_(function() mouse1press() end)
    task_wait()
    pcall_(function() mouse1release() end)
    return true, sformat("%d,%d", cx, cy)
end

local function _getManageRoot()
    local pg; pcall_(function() pg = player:FindFirstChildOfClass("PlayerGui") end)
    if not pg then return nil end
    local node = pg
    for _, seg in ipairs_(STAND_MANAGE_PATH) do
        local nxt; pcall_(function() nxt = node:FindFirstChild(seg) end)
        if not nxt then return nil end
        node = nxt
