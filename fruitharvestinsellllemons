local function Render()
    local upx, upy = uiPos.X, uiPos.Y
    local usx, usy = uiSize.X, uiSize.Y

    Shadow.Position   = Vec2(upx - 3, upy - 3)
    MainBG.Position   = uiPos
    TopBar.Position   = uiPos
    AccLine.Position  = Vec2(upx, upy + 30)
    TitleTxt.Position = Vec2(upx + 10, upy + 8)

    local slotX_lbl   = upx + 16
    local slotX_check = upx + usx - 22

    local slot = 0
    for i = 1, FCOUNT do
        local f = F[i]
        slot = slot + 1
        if slot <= MAXS then
            local yy   = upy + 60 + ((slot - 1) * 28)
            local lbl  = SLabel[slot]
            local chk  = SCheck[slot]
            local fll  = SFill[slot]
            local kind = f.kind
            local isAction = (kind == "action")

            lbl.Text     = isAction and (">> " .. f.label) or ("> " .. f.label)
            lbl.Position = Vec2(slotX_lbl, yy)
            lbl.Color    = isAction and COL_LBL_ACT or (f.value and COL_LBL_ON or COL_LBL_OFF)
            lbl.Visible  = true

            local checkPos = Vec2(slotX_check, yy + 7)
            chk.Position = checkPos
            chk.Visible  = (kind == "toggle")

            fll.Position = checkPos
            fll.Visible  = (kind == "toggle" and f.value == true)
        end
    end
    for i = slot + 1, MAXS do
        SLabel[i].Visible = false
        SCheck[i].Visible = false
        SFill[i].Visible  = false
    end

    local chr = player.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    local yVal = hrp and mfloor(hrp.Position.Y) or "?"

    StatusTxt.Text = sformat("Y:%s | Btns:%d | Lems:%d | Cash:%d | B:%d | Q:%d/%d",
        tostring_(yVal), lastButtonCount, lastLemonCount, lastCashCount,
        totalBought, (#localQueue - queueIndex + 1), #localQueue)
    StatusTxt.Position = Vec2(upx + 10, upy + usy - 16)
end

task_spawn(function()
    while ScriptActive do
        task_wait(0.016)
        local mx, my = 0, 0
        if mouse then
            pcall_(function() mx = mouse.X; my = mouse.Y end)
        else
            pcall_(function() local m = player:GetMouse(); mx = m.X; my = m.Y end)
        end
        local m1 = false
        pcall_(function() m1 = ismouse1pressed() end)

        if m1 and not lastM1 then
            local upx, upy = uiPos.X, uiPos.Y
            local usx      = uiSize.X
            local xMin, xMax = upx + 10, upx + usx - 10

            local slot = 0
            for i = 1, FCOUNT do
                local f = F[i]
                slot = slot + 1
                if slot <= MAXS then
                    local yy = upy + 60 + ((slot - 1) * 28)
                    if mx >= xMin and mx <= xMax and my >= yy - 2 and my <= yy + 22 then
                        local kind = f.kind
                        if kind == "toggle" then
                            local key = f.key
                            if key == "AutoBuy" and not f.value then
                                for j = 1, FCOUNT do
                                    local ff = F[j]
                                    if ff.key == "LemonFarm" then ff.value = false end
                                end
                            elseif key == "LemonFarm" and not f.value then
                                for j = 1, FCOUNT do
                                    local ff = F[j]
                                    if ff.key == "AutoBuy" then ff.value = false end
                                end
                            end
                            f.value = not f.value
                            syncFromUI()
                            print("[Hub] TOGGLED: " .. key .. " = " .. tostring_(f.value))
                        elseif kind == "action" then
                            print("[Hub] ACTION: " .. f.key)
                            if f.key == "StopAll" then stopAll() end
                        end
                    end
                end
            end

            if mx >= upx and mx <= upx + usx and my >= upy and my <= upy + 30 then
                dragging = true
                dragOff  = Vec2(mx - upx, my - upy)
            end
        end

        if dragging then
            if m1 then
                uiPos = Vec2(mx - dragOff.X, my - dragOff.Y)
            else
                dragging = false
            end
        end

        lastM1 = m1
        pcall_(Render)
    end
end)

