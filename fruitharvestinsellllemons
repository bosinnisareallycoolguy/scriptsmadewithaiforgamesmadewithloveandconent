-- ==================== LEMON FARM ====================
-- Anti-stuck: registra intentos por limón (por posición). Si un limón falla N veces
-- consecutivas, se marca como inalcanzable temporalmente para no bloquear la pasada.
local lemonFailCount  = {}   -- [posKey] = nº de intentos fallidos consecutivos
local LEMON_MAX_FAILS = 3    -- tras este nº, se ignora durante el ciclo actual
local LEMON_MAX_PASSES = 6   -- tope de re-escaneos por ciclo (seguridad)

-- HITBOX EXPANSION: agranda el ClickPart antes del click para que el cursor
-- pegue aunque la cámara esté ligeramente desalineada. Se restaura al terminar.
local LEMON_HITBOX_ENABLED = true
local LEMON_HITBOX_SIZE    = Vec3(50, 50, 50)   -- 50x50x50 studs (ajustable)

local function lemonKey(v)
    local pos = v.Position
    return mfloor(pos.X + 0.5) .. "," .. mfloor(pos.Y + 0.5) .. "," .. mfloor(pos.Z + 0.5)
end

-- Procesa un único limón (extraído del bucle original sin cambios de método)
local function processLemon(v, hrp)
    if not v or not v:IsDescendantOf(Workspace) then return false end

    local fruit    = v.Parent
    local tree     = fruit and fruit.Parent
    local modified = {}
    local modCount = 0

    if tree then
        for _, part in ipairs_(tree:GetDescendants()) do
            if part ~= v and part:IsA("BasePart") then
                pcall_(function()
                    part.CanQuery = false
                    modCount = modCount + 1
                    modified[modCount] = part
                end)
            end
        end
    end

    -- HITBOX EXPANSION: guarda Size/Transparency/CanCollide originales y los agranda
    local origSize, origTransp, origCanColl = nil, nil, nil
    local hitboxApplied = false
    if LEMON_HITBOX_ENABLED then
        pcall_(function()
            origSize    = v.Size
            origTransp  = v.Transparency
            origCanColl = v.CanCollide
            v.CanCollide   = false
            v.Transparency = 1
            v.Size         = LEMON_HITBOX_SIZE
            hitboxApplied  = true
        end)
    end

    local vp = v.Position
    local tpX, tpY, tpZ = vp.X, vp.Y - 4, vp.Z
    hrp.CFrame = CF(tpX, tpY, tpZ)
    task_wait(0.02)

    camera.lookAt(Vec3(tpX, tpY, tpZ), vp)
    task_wait(0.02)

    local vps = camera.ViewportSize
    local cx  = mfloor(vps.X / 2)
    local cy  = mfloor(vps.Y / 2)
    mousemoveabs(cx, cy)
    mouse1click()
    task_wait(0.015)
    mouse1click()

    -- Verifica si el limón desapareció ANTES de restaurar (el part puede estar muerto)
    local collected = not (v and v.Parent and v:IsDescendantOf(Workspace))

    -- Restaurar hitbox original (solo si lo tocamos y el part sigue vivo)
    if hitboxApplied and not collected then
        pcall_(function()
            if origSize    ~= nil then v.Size         = origSize    end
            if origTransp  ~= nil then v.Transparency = origTransp  end
            if origCanColl ~= nil then v.CanCollide   = origCanColl end
        end)
    end

    -- Restaurar CanQuery de los demás parts del árbol
    for j = 1, modCount do
        local part = modified[j]
        pcall_(function() part.CanQuery = true end)
    end
    task_wait(0.015)

    return collected
end

task_spawn(function()
    while ScriptActive do
        syncFromUI()
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if lemonFarmActive and hrp then
            -- Reset de contadores al iniciar cada ciclo completo
            lemonFailCount = {}

            local pass            = 0
            local lastSeenCount   = -1
            local sameCountStreak = 0

            -- Bucle de pasadas: re-escanea hasta que no queden limones
            -- (o se exceda el tope de seguridad)
            while ScriptActive and lemonFarmActive and pass < LEMON_MAX_PASSES do
                pass = pass + 1
                local snapshot = getLemonsFast()
                local count    = #snapshot
                lastLemonCount = count

                if count == 0 then break end

                -- Detecta estancamiento (mismo conteo en varias pasadas
                -- = limones inalcanzables, no tiene sentido seguir)
                if count == lastSeenCount then
                    sameCountStreak = sameCountStreak + 1
                    if sameCountStreak >= 2 then break end
                else
                    sameCountStreak = 0
                    lastSeenCount = count
                end

                -- Refresh del HRP por si el personaje se respawneó entre pasadas
                local chr2 = player.Character
                hrp = chr2 and chr2:FindFirstChild("HumanoidRootPart")
                if not hrp then break end

                for i = 1, count do
                    if not lemonFarmActive then break end
                    local v = snapshot[i]
                    if v and v:IsDescendantOf(Workspace) then
                        local lk    = lemonKey(v)
                        local fails = lemonFailCount[lk] or 0

                        -- Salta limones que ya fallaron demasiadas veces este ciclo
                        if fails < LEMON_MAX_FAILS then
                            local ok = processLemon(v, hrp)
                            if ok then
                                lemonFailCount[lk] = nil
                            else
                                lemonFailCount[lk] = fails + 1
                            end
                        end
                    end
                end

                -- Pequeño wait entre pasadas para dejar que el server
                -- procese los limones recién recogidos antes de re-escanear
                task_wait(0.08)
            end

            task_wait(0.1)
        else
            task_wait(0.05)
        end
    end
end)

