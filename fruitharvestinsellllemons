local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local camera = workspace.CurrentCamera
local player = Players.LocalPlayer

setrobloxinput(true)

if _G.SellLemonsConnection then
    pcall(function() _G.SellLemonsConnection:Disconnect() end)
    _G.SellLemonsConnection = nil
end

if _G.SellLemonsActive then
    _G.SellLemonsActive = false
    task.wait(0.2)
end
_G.SellLemonsActive = true

local KEYS = { AUTOBUY = 49, LEMON = 50, STOP = 57 }
local activeMode = "none"
local currentFruit = nil

local key1Down = false
local key2Down = false
local key9Down = false

local cachedButtons = {}
local lastScanTime = 0
local needsRescan = true
local buttonsContainer = nil
local lastContainerScan = 0
local myTycoon = nil

local function safeCall(fn)
    local ok, err = pcall(fn)
    if not ok then warn("[SellLemons] " .. tostring(err)) end
end

local function getTycoon()
    for _, tycoon in pairs(workspace:GetChildren()) do
        if tycoon.Name:find("Tycoon") then
            local owner = tycoon:FindFirstChild("Owner")
            if owner and tostring(owner.Value):find(player.Name) then
                return tycoon
            end
        end
    end
    return nil
end

local function normalizeColor(c)
    local r, g, b = c.R, c.G, c.B
    if r <= 1 and g <= 1 and b <= 1 then
        r, g, b = r * 255, g * 255, b * 255
    end
    return r, g, b
end

local function isGreyedOut(v)
    local ok, color3 = pcall(function() return v.Color end)
    if not ok or not color3 then return false end
    local r, g, b = normalizeColor(color3)
    return math.abs(r - g) < 30 and math.abs(g - b) < 30 and math.abs(r - b) < 30 and r < 200
end

local function getButtonsContainer(tycoon)
    if buttonsContainer and buttonsContainer:IsDescendantOf(tycoon) then
        return buttonsContainer
    end
    local now = tick()
    if (now - lastContainerScan) < 1.0 then return tycoon end
    lastContainerScan = now
    for _, child in ipairs(tycoon:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            local name = child.Name:lower()
            if name:find("button") or name:find("purchase") or name:find("buy") then
                buttonsContainer = child
                return child
            end
        end
    end
    for _, v in pairs(tycoon:GetDescendants()) do
        if v.Name == "Button" and v:IsA("BasePart") then
            local ancestor = v.Parent
            while ancestor and ancestor.Parent and ancestor.Parent ~= tycoon and ancestor.Parent ~= workspace do
                ancestor = ancestor.Parent
            end
            if ancestor and ancestor ~= tycoon then
                buttonsContainer = ancestor
                return ancestor
            end
        end
    end
    return tycoon
end

local function getButtons(tycoon)
    local now = tick()
    local shouldScan = needsRescan
        or ((#cachedButtons == 0) and (now - lastScanTime) > 1.0)
        or ((now - lastScanTime) > 1.0)
    if shouldScan then
        needsRescan = false
        lastScanTime = now
        local container = getButtonsContainer(tycoon)
        local buttons = {}
        local searchList = (container == tycoon) and container:GetChildren() or container:GetDescendants()
        for _, v in pairs(searchList) do
            if v and v.Parent and v.Name == "Button" and v:IsA("BasePart") then
                table.insert(buttons, v)
            end
        end
        cachedButtons = buttons
    end
    local activeButtons = {}
    for _, btn in ipairs(cachedButtons) do
        if btn and btn.Parent and btn:IsDescendantOf(tycoon) then
            table.insert(activeButtons, btn)
        end
    end
    return activeButtons
end

local function resetBuyState()
    cachedButtons = {}
    buttonsContainer = nil
    lastContainerScan = 0
    needsRescan = true
end

myTycoon = getTycoon()
print("=== Sell Lemons Script ===")
print("1 = Toggle Auto Buy | 2 = Toggle Lemon Farm | 9 = Stop All")
print(myTycoon and "Tycoon found: " .. myTycoon.Name or "WARNING: Tycoon not found!")

_G.SellLemonsConnection = RunService.RenderStepped:Connect(function()
    if not _G.SellLemonsActive then return end

    if activeMode == "farm" then
        local chr = player.Character
        local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
        if hrp then
            safeCall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 2, 0) end)
            if currentFruit then
                local headPos = hrp.Position + Vector3.new(0, 1.5, 0)
                camera.lookAt(headPos, currentFruit)
            end
        end
    end

    -- Key 1 toggle auto buy
    local k1 = iskeypressed(KEYS.AUTOBUY)
    if k1 and not key1Down then
        key1Down = true
        if activeMode == "buy" then
            activeMode = "none"
            print("Auto Buy: OFF")
        else
            activeMode = "buy"
            resetBuyState()
            print("Auto Buy: ON")
        end
    elseif not k1 then
        key1Down = false
    end

    -- Key 2 toggle lemon farm
    local k2 = iskeypressed(KEYS.LEMON)
    if k2 and not key2Down then
        key2Down = true
        if activeMode == "farm" then
            activeMode = "none"
            currentFruit = nil
            print("Lemon Farm: OFF")
        else
            activeMode = "farm"
            print("Lemon Farm: ON")
        end
    elseif not k2 then
        key2Down = false
    end

    -- Key 9 stop all
    local k9 = iskeypressed(KEYS.STOP)
    if k9 and not key9Down then
        key9Down = true
        activeMode = "none"
        currentFruit = nil
        print("Everything stopped!")
    elseif not k9 then
        key9Down = false
    end
end)

task.spawn(function()
    while _G.SellLemonsActive do
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if not myTycoon then
            myTycoon = getTycoon()
            if myTycoon then
                buttonsContainer = nil
                lastContainerScan = 0
            end
        end

        -- AUTO BUY
        if activeMode == "buy" and myTycoon and hrp then
            local buttons = getButtons(myTycoon)
            local anyBuyable = false

            for _, button in ipairs(buttons) do
                if activeMode ~= "buy" then break end
                local exists = button and button.Parent and button:IsDescendantOf(myTycoon)
                if not exists then continue end
                if isGreyedOut(button) then continue end

                anyBuyable = true

                safeCall(function()
                    if firetouchinterest then
                        hrp.CFrame = CFrame.new(button.Position.X, button.Position.Y, button.Position.Z)
                        firetouchinterest(button, hrp, 0)
                        task.wait(0.02)
                        firetouchinterest(button, hrp, 1)
                    else
                        hrp.CFrame = CFrame.new(button.Position.X, button.Position.Y + 2.5, button.Position.Z)
                        task.wait(0.04)
                        hrp.CFrame = CFrame.new(button.Position.X, button.Position.Y + 0.8, button.Position.Z)
                        task.wait(0.04)
                    end
                end)

                task.wait(0.01)
            end

            needsRescan = true

            if not anyBuyable then
                task.wait(0.5)
                resetBuyState()
            else
                task.wait(0.05)
            end

        -- LEMON FARM
        elseif activeMode == "farm" and hrp then
            local count = 0
            for _, v in pairs(workspace:GetDescendants()) do
                if activeMode ~= "farm" then break end
                count = count + 1
                if count % 200 == 0 then task.wait() end

                if v.Name == "ClickPart" then
                    local fruit = v.Parent
                    local tree = fruit and fruit.Parent

                    local modified = {}
                    if tree then
                        for _, part in pairs(tree:GetDescendants()) do
                            if part:IsA("BasePart") and part ~= v then
                                pcall(function()
                                    part.CanQuery = false
                                    table.insert(modified, part)
                                end)
                            end
                        end
                    end

                    if not v or not v:IsDescendantOf(workspace) then continue end

                    local tpPos = Vector3.new(v.Position.X, v.Position.Y - 4, v.Position.Z)
                    hrp.CFrame = CFrame.new(tpPos.X, tpPos.Y, tpPos.Z)
                    currentFruit = v.Position

                    local cx = math.floor(camera.ViewportSize.X / 2)
                    local cy = math.floor(camera.ViewportSize.Y / 2)
                    mousemoveabs(cx, cy)

                    local deadline = tick() + 0.15
                    while tick() < deadline and v and v:IsDescendantOf(workspace) do
                        if activeMode ~= "farm" then break end
                        mouse1click()
                        task.wait(0.04)
                    end

                    for _, part in pairs(modified) do
                        pcall(function() part.CanQuery = true end)
                    end
                end
            end
            print("Lemon sweep done!")
            task.wait(0.1)

        else
            task.wait(0.1)
        end
    end
end)
