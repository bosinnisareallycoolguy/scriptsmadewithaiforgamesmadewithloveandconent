-- Cuanto tiempo spamear E sobre un stand activo, y a que ritmo:
-- v5.17.0: subido a 1.5s porque la cadencia nueva da ~28 presses/seg
-- (1.5s * 28 = ~42 activaciones por stand, antes ~15 con 1.0s a ~15/seg)
local STAND_E_SPAM_DURATION = 1.5    -- segundos por stand
local STAND_E_SPAM_INTERVAL = 0.018  -- gap entre taps (legacy; el path optimo lo ignora)

-- Detecta el ScrollingFrame ancestro mas cercano de un GuiObject.
local function _findScrollAncestor(obj)
    local cur = obj
    while cur and cur.Parent do
        cur = cur.Parent
        local ok, isScroll = pcall_(function() return cur:IsA("ScrollingFrame") end)
        if ok and isScroll then return cur end
        if cur:IsA("ScreenGui") then break end
    end
    return nil
end

-- Ajusta CanvasPosition.Y del ScrollingFrame para que `child` quede DENTRO del
-- viewport visible. Despues yield-ea para que el render se actualice.
local function _ensureVisibleInScroll(child)
    if not child or not child.Parent then return false end
    local sf = _findScrollAncestor(child)
    if not sf then return true end  -- no hay scroll, ya esta visible
    local ok, err = pcall_(function()
        local childY    = child.AbsolutePosition.Y
        local sfY       = sf.AbsolutePosition.Y
        local viewportH = sf.AbsoluteWindowSize.Y
        local childH    = child.AbsoluteSize.Y
        local relTop    = childY - sfY                  -- posicion del top del child relativa al viewport
        local relBot    = relTop + childH               -- bottom relativo
        local cur       = sf.CanvasPosition
        if relTop < 0 then
            -- arriba del viewport -> scroll up
            sf.CanvasPosition = Vec2(cur.X, math.max(0, cur.Y + relTop - 4))
        elseif relBot > viewportH then
            -- abajo del viewport -> scroll down
            sf.CanvasPosition = Vec2(cur.X, cur.Y + (relBot - viewportH) + 4)
        end
    end)
    task_wait() ; task_wait()  -- 2 frames para que se renderice
    return ok
end

-- ===== Deteccion ACTIVO/INACTIVO via memoria (Matcha) =====
-- Matcha bloquea el acceso por __index a las propiedades visuales de los GUI
-- (BackgroundColor3 etc. devuelven nil). Pero expone `memory_read` y `obj.Address`,
-- asi que leemos el BackgroundColor3 del ImageButton directamente de memoria.
-- Offset descubierto por BruteForceColor (ver doc Matcha): 0x540 (1344).
local GUI_BG_COLOR_OFFSET = 0x540

-- Color del estado INACTIVO/gris que el juego muestra cuando no se puede pagar.
-- El AZUL/activo varia mas (cyan, magenta segun stand), por eso decidimos por
-- distancia al gris: si esta cerca del gris -> inactivo; cualquier otra cosa -> activo.
local STAND_INACTIVE_RGB    = {0.49, 0.49, 0.49}   -- ~125/255 cada canal
local STAND_COLOR_TOLERANCE = 0.06                  -- tolerancia por canal

local function _readGuiBgColor(guiObject)
    if not guiObject then return nil end
    local addr; pcall_(function() addr = tonumber(guiObject.Address) end)
    if not addr or addr <= 4096 then return nil end
    if type(memory_read) ~= "function" then return nil end
    local okR, r = pcall_(memory_read, "float", addr + GUI_BG_COLOR_OFFSET)
    if not okR then return nil end
    local okG, g = pcall_(memory_read, "float", addr + GUI_BG_COLOR_OFFSET + 4)
    if not okG then return nil end
    local okB, b = pcall_(memory_read, "float", addr + GUI_BG_COLOR_OFFSET + 8)
    if not okB then return nil end
    if type(r) ~= "number" or type(g) ~= "number" or type(b) ~= "number" then return nil end
    -- Sanidad: floats entre 0 y 1
    if r < -0.01 or r > 1.01 or g < -0.01 or g > 1.01 or b < -0.01 or b > 1.01 then return nil end
    return r, g, b
end

-- Devuelve true/false segun color. Si no pudo leer la memoria, devuelve nil
-- (usado como senal para que runManagePass haga fallback al delta-detector).
local function _isUpgradeActive(upg)
    local r, g, b = _readGuiBgColor(upg)
    if not r then return nil end
    local tol = STAND_COLOR_TOLERANCE
    local ir, ig, ib = STAND_INACTIVE_RGB[1], STAND_INACTIVE_RGB[2], STAND_INACTIVE_RGB[3]
    if math.abs(r - ir) <= tol and math.abs(g - ig) <= tol and math.abs(b - ib) <= tol then
        return false, r, g, b
    end
    return true, r, g, b
end

-- ===== Fallback por delta de Count/Price (si memory_read falla) =====
local STAND_INACTIVE_RETEST_AFTER = 8
local _standInactiveSince = {}

local function _readUpgradeState(upgBtn)
