local function normalizeColor(c)
    local r, g, b = c.R, c.G, c.B
    if r <= 1 and g <= 1 and b <= 1 then
        r, g, b = r * 255, g * 255, b * 255
    end
    return r, g, b
end

local function isGreyedOut(v)
    local ok, color3 = pcall_(function() return v.Color end)
    if not ok or not color3 then return false end
    local r, g, b = normalizeColor(color3)
    return mabs(r - g) < 30 and mabs(g - b) < 30 and mabs(r - b) < 30 and r < 200
end

-- ===== Cached button scan =====
-- Mantiene una lista de botones conocidos y la valida con .Parent en cada call (barato).
-- Solo cada BUTTON_RESCAN_INTERVAL segundos hace un walk completo con GetDescendants
-- para detectar botones recién spawneados (caro pero infrecuente).
local buttonCache            = {}
local buttonCacheKeys        = {}
local lastFullRescan         = 0

local function invalidateButtonCache()
    buttonCache     = {}
    buttonCacheKeys = {}
    lastFullRescan  = 0
end

-- Fuerza que el próximo getButtonsRealTime() haga un rescan completo
-- (sin tirar el cache existente). Usado cuando la cola queda crítica.
-- v5.9: dos variantes
--   forceFullRescan()    -> throttled, para llamadas frecuentes del Coord
--   forceFullRescanNow() -> sin throttle, para emergencias del Worker
-- El throttle evita force-rescan storms del Coord (que llama cada COORD_WAIT)
-- pero el Worker SIEMPRE debe poder forzar rescan inmediato cuando está vacío.
local lastForceRescan = 0
local function forceFullRescan()
    local now = tick_()
    if now - lastForceRescan >= FORCE_RESCAN_MIN_GAP then
        lastForceRescan = now
        lastFullRescan  = 0
    end
end
local function forceFullRescanNow()
    lastForceRescan = tick_()
    lastFullRescan  = 0
end

local function fullRescanButtons()
    if not myTycoon or not myTycoon.Parent then return end
    local purchases = myTycoon:FindFirstChild("Purchases")
    if not purchases then return end

    for _, purchaseFolder in ipairs_(purchases:GetChildren()) do
        local buttonsFolder = purchaseFolder:FindFirstChild("Buttons")
        if buttonsFolder then
            for _, model in ipairs_(buttonsFolder:GetChildren()) do
                local btn = model:FindFirstChild("Button")
                if btn and btn:IsA("BasePart") and btn.Parent then
                    local k = getButtonKey(btn)
                    if k and not buttonCacheKeys[k] then
                        buttonCacheKeys[k] = true
                        tinsert(buttonCache, btn)
                    end
                end
                for _, child in ipairs_(model:GetDescendants()) do
                    if child.Name == "Button" and child ~= btn and child:IsA("BasePart") and child.Parent then
                        local k = getButtonKey(child)
                        if k and not buttonCacheKeys[k] then
                            buttonCacheKeys[k] = true
                            tinsert(buttonCache, child)
                        end
                    end
                end
            end
        end
    end
    lastFullRescan = tick_()
end

local function getButtonsRealTime()
    if not myTycoon then return {} end

    -- Rescan completo periódico para detectar nuevos botones (caro pero infrecuente)
    if tick_() - lastFullRescan >= BUTTON_RESCAN_INTERVAL then
        fullRescanButtons()
    end

    -- Hot path: poda dead buttons del cache (solo .Parent check, muy barato)
    local alive    = {}
    local aliveKey = {}
    local n        = 0
    local cache    = buttonCache
    for i = 1, #cache do
        local b = cache[i]
        if b and b.Parent then
            n = n + 1
            alive[n] = b
            local k = getButtonKey(b)
            if k then aliveKey[k] = true end
        end
    end
    buttonCache     = alive
    buttonCacheKeys = aliveKey
    return alive
end

local function getLemonsFast()
    local temp = {}

    -- Helper: extrae limones de un LemonTree dado y los agrega a `temp`
    local function harvestLemonTree(lemonTree)
        for _, fruit in ipairs_(lemonTree:GetChildren()) do
            if fruit.Name == "Fruit" then
                local clickPart = fruit:FindFirstChild("ClickPart")
                if clickPart and clickPart:IsA("BasePart") then
                    tinsert(temp, clickPart)
                end
                for _, child in ipairs_(fruit:GetDescendants()) do
                    if child.Name == "ClickPart" and child ~= clickPart and child:IsA("BasePart") then
                        tinsert(temp, child)
                    end
                end
            end
        end
    end

    -- (1) LemonTree directo en Workspace (game.Workspace.LemonTree.Fruit)
    local rootLemonTree = Workspace:FindFirstChild("LemonTree")
    if rootLemonTree then
        harvestLemonTree(rootLemonTree)
    end

    -- (2) LemonTree dentro de cada Tycoon (Tycoon → Constant → Trees → LemonTree)
    for _, tycoon in ipairs_(Workspace:GetChildren()) do
        if tycoon.Name:find("Tycoon") then
            local constant = tycoon:FindFirstChild("Constant")
            if not constant then continue end
            local trees = constant:FindFirstChild("Trees")
            if not trees then continue end
            local lemonTree = trees:FindFirstChild("LemonTree")
            if not lemonTree then continue end

            harvestLemonTree(lemonTree)
        end
    end

    return temp
end

local function getCashDropsFast()
    local folder = Workspace:FindFirstChild("CashDrops")
    if not folder then return {} end
    local temp = {}
    for _, v in ipairs_(folder:GetDescendants()) do
        if v.Name == "TouchInterest" then
            local parent = v.Parent
            if parent and parent:IsA("BasePart") then
                tinsert(temp, parent)
            end
        end
    end
    return temp
end

